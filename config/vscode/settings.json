{
    // WORKBENCH
    "workbench.colorCustomizations": {
        "[Tokyo Night Storm]": {
            "tab.activeBorderTop": "#3d59a1",
            "tab.activeBorder": "#1f2335",
            "widget.shadow": "#0000008c",
            // Contrast
            "foreground": "#959cbd",
            "panelTitle.activeBorder": "#3d59a1",
            "panelTitle.activeForeground": "#bdc7f0",
            "panelTitle.inactiveForeground": "#959cbd",
            "tab.activeForeground": "#bdc7f0",
            "tab.inactiveForeground": "#959cbd",
            "breadcrumb.foreground": "#959cbd",
            "breadcrumb.focusForeground": "#bdc7f0",
            "breadcrumb.activeSelectionForeground": "#bdc7f0",
            "statusBar.foreground": "#bdc7f0",
            "list.focusForeground": "#bdc7f0",
            "list.hoverForeground": "#bdc7f0",
            "list.activeSelectionForeground": "#bdc7f0",
            "list.inactiveSelectionForeground": "#bdc7f0",
            "list.inactiveSelectionBackground": "#202330",
            "sideBar.foreground": "#959cbd",
            "dropdown.foreground": "#959cbd",
            "menu.foreground":"#bdc7f0",
            "menubar.selectionForeground":"#bdc7f0",
            "input.foreground": "#959cbd",
            "input.placeholderForeground": "#959cbd",
            "activityBar.foreground": "#bdc7f0",
            "activityBar.inactiveForeground": "#787c99",
            "gitDecoration.ignoredResourceForeground": "#696d87",
        }
    },
    "workbench.colorTheme": "Tokyo Night Storm",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.accounts.showAvatar": false,
    "workbench.browser.searchEngine": "none",
    "workbench.commandPalette.history": 0,
    "workbench.editor.empty.hint": "hidden",
    "workbench.editor.languageDetection": false,
    "workbench.editor.tabSizing": "fixed",
    "workbench.editor.tabSizingFixedMaxWidth": 180,
    "workbench.layoutControl.type": "toggles",
    "workbench.list.smoothScrolling": true,
    "workbench.settings.editor": "json",
    "workbench.tips.enabled": false,
    "breadcrumbs.enabled": false,
    "workbench.experimental.modernUI": true,
    // EDITOR
    "editor.bracketPairColorization.enabled": false,
    "editor.codeLens": false,
    "editor.cursorBlinking": "phase",
    "editor.cursorSmoothCaretAnimation": "on",
    //"editor.hover.enabled": false,
    "editor.fontFamily": "JetBrains Mono, Cascadia Code, Noto Sans Mono, monospace",
    "editor.fontLigatures": true,
    "editor.inlayHints.enabled": "off",
    "editor.lineHeight": 1.6,
    "editor.linkedEditing": true,
    "editor.minimap.renderCharacters": false,
    "editor.parameterHints.enabled": false,
    "editor.renderWhitespace": "trailing",
    "editor.rulers": [120],
    "editor.selectionClipboard": false,
    "editor.semanticHighlighting.enabled": true,
    "editor.scrollBeyondLastLine": false,
    "editor.smoothScrolling": true,
    "editor.stickyScroll.enabled": false,
    "editor.stickyTabStops": true,
    "editor.suggestSelection": "first",
    // DEBUGGER
    "debug.console.closeOnEnd": true,
    "debug.showInStatusBar": "never",
    "debug.toolBarLocation": "commandCenter",
    "launch": {
        "configurations": [
            {
                "name": "Python",
                "type": "debugpy",
                "request": "launch",
                "program": "${file}",
                "console": "integratedTerminal",
            },
        ]
    },
    // FILE EXPLORER
    "explorer.compactFolders": false,
    "files.associations": {
        "fonts.conf": "xml"
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/__pycache__": true,
        "**/.venv": true
    },
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    // TERMINAL
    "accessibility.signals.terminalBell": {
        "sound": "on"
    },
    "terminal.external.linuxExec": "ghostty",
    "terminal.integrated.confirmOnExit": "always",
    "terminal.integrated.enableImages": true,
    "terminal.integrated.enableVisualBell": true,
    "terminal.integrated.fontFamily": "JetBrains Mono, Consolas, Hack, Noto Sans Mono, monospace",
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.profiles.linux": {
        "zsh": {
            "path": "zsh",
            "icon": "terminal-linux",
        },
        "bash": null,
        "JavaScript Debug Terminal": null,
    },
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell",
            "args": [
                "-NoLogo"
            ],
        }
    },
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.shellIntegration.decorationsEnabled": "never",
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.stickyScroll.enabled": false,
    // WINDOW
    "window.commandCenter": true,
    "window.density.layout": "default",
    "window.dialogStyle": "custom",
    "window.menuBarVisibility": "compact",
    "window.titleBarStyle": "custom",
    // OTHERS
    "network.meteredConnection": "off",
    // ANNOYANCES
    "chat.disableAIFeatures": true,
    "extensions.autoUpdate": "off",
    "extensions.ignoreRecommendations": true,
    "git.addAICoAuthor": "off",
    "security.workspace.trust.enabled": false,
    "telemetry.telemetryLevel": "off",
    "terminal.integrated.initialHint": false,
    "update.showReleaseNotes": false,
    "workbench.settings.enableNaturalLanguageSearch": false,
    // PROGRAMMING LANGUAGES
    "html.format.indentInnerHtml": true,
    "json.schemaDownload.trustedDomains": {
        "https://developer.microsoft.com/json-schemas/": true,
        "https://github.com": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://www.schemastore.org/": true
    },
    "[javascript]": {
        "editor.semanticHighlighting.enabled": false,
        "js/ts.suggest.completeFunctionCalls": true,
        "js/ts.suggest.paths": false,
        "js/ts.validate.enabled": false,
    },
    "[markdown]": {
        "editor.wordWrap": "off",
        "editor.quickSuggestions": {
            "comments": "off",
            "strings": "off",
            "other": "off"
        },
        "files.trimFinalNewlines": false
    },
    "[plaintext]": {
        "editor.quickSuggestions": {
            "comments": "off",
            "strings": "off",
            "other": "off"
        },
        "editor.wordWrap": "bounded",
        "files.trimTrailingWhitespace": false
    },
    "[powershell]": {
        "files.eol": "\r\n"
    },
    "[python]": {
        "editor.formatOnType": true,
        "editor.defaultFormatter": "eeyore.yapf"
    },
    "[shellscript]": {
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": false
        }
    },
    // EXTENSIONS
    "material-icon-theme.activeIconPack": "none",
    "material-icon-theme.folders.theme": "classic",
    "path-autocomplete.disableUpOneFolder": false,
    "path-autocomplete.excludedItems": {
        "**": {
            "when": "**/*.html",
            "context": "(src|href)=.*"
        }
    },
    "python.analysis.autoImportCompletions": true,
    "python.analysis.completeFunctionParens": true,
    "python.analysis.typeCheckingMode": "basic",
}
